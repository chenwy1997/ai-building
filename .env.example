# PostgreSQL 服务连接。URL 中的库名仅作为管理连接入口，业务代码会替换成目标库名。
AI_BUILDING_POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# 用于加密 ai-building-public 中的 API Key 等敏感值。
# 生成方式：openssl rand -base64 32
AI_BUILDING_MASTER_KEY=

# 仅用于首次写入公共库：bun run cli ai:key:set deepseek
# 成功写入后可从本地 .env 删除。
DEEPSEEK_API_KEY=

# 日志级别：debug | info | warn | error
AI_BUILDING_LOG_LEVEL=info
